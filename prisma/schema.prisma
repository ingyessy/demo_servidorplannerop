generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  dni               String              @unique
  name              String
  username          String              @unique
  password          String
  phone             String
  role              Role                @default(ADMIN)
  occupation        String
  status            StatusActivation    @default(ACTIVE)
  id_site           Int                 @default(1)
  id_subsite        Int?
  Bill              Bill[]
  calledAttention   CalledAttention[]
  client            Client[]
  clientProgramming ClientProgramming[]
  Configuration     Configuration[]
  CostCenter        CostCenter[]
  inChargeOperation InChargeOperation[]
  inability         Inability[]
  areas             JobArea[]
  operation         Operation[]
  permissions       Permission[]
  createdSites      Site[]              @relation("SiteCreator")
  Tariff            Tariff[]
  task              Task[]
  UnitOfMeasure     UnitOfMeasure[]
  Site              Site                @relation(fields: [id_site], references: [id])
  subSite           SubSite?            @relation(fields: [id_subsite], references: [id])
  worker            Worker[]
  WorkerFeeding     WorkerFeeding[]
}

model JobArea {
  id         Int              @id @default(autoincrement())
  name       String
  id_user    Int
  status     StatusActivation @default(ACTIVE)
  id_site    Int              @default(1)
  id_subsite Int?
  Site       Site             @relation(fields: [id_site], references: [id])
  subSite    SubSite?         @relation(fields: [id_subsite], references: [id])
  user       User             @relation(fields: [id_user], references: [id])
  operations Operation[]
  workers    Worker[]
}

model Worker {
  id               Int                @id @default(autoincrement())
  dni              String             @unique
  phone            String?
  name             String
  status           Status             @default(AVALIABLE)
  id_area          Int?
  createAt         DateTime           @default(now())
  updateAt         DateTime           @updatedAt
  id_user          Int
  code             String?
  dateDisableEnd   DateTime?
  dateDisableStart DateTime?
  dateRetierment   DateTime?
  hoursWorked      Float              @default(0)
  failures         Int                @default(0)
  id_site          Int                @default(1)
  id_subsite       Int?
  payroll_code     String?            @unique
  calledAttention  CalledAttention[]
  inability        Inability[]
  operations       Operation_Worker[]
  permissions      Permission[]
  jobArea          JobArea?           @relation(fields: [id_area], references: [id])
  Site             Site               @relation(fields: [id_site], references: [id])
  subSite          SubSite?           @relation(fields: [id_subsite], references: [id])
  user             User               @relation(fields: [id_user], references: [id])
  feeding          WorkerFeeding[]
}

model Operation {
  id                   Int                 @id @default(autoincrement())
  status               StatusOperation     @default(PENDING)
  dateStart            DateTime            @db.Date
  dateEnd              DateTime?           @db.Date
  timeStrat            String
  timeEnd              String?
  id_user              Int
  id_area              Int
  id_task              Int?
  id_client            Int
  motorShip            String?
  zone                 Int
  createAt             DateTime            @default(now())
  updateAt             DateTime            @default(now()) @updatedAt
  id_clientProgramming Int?
  id_site              Int                 @default(1)
  id_subsite           Int?
  op_duration          Float?              @default(0)
  Bill                 Bill[]
  inChargeOperation    InChargeOperation[]
  confirmation         OperationConfirmation?
  jobArea              JobArea             @relation(fields: [id_area], references: [id])
  clientProgramming    ClientProgramming?  @relation(fields: [id_clientProgramming], references: [id])
  client               Client              @relation(fields: [id_client], references: [id])
  Site                 Site                @relation(fields: [id_site], references: [id])
  subSite              SubSite?            @relation(fields: [id_subsite], references: [id])
  task                 Task?               @relation(fields: [id_task], references: [id])
  user                 User                @relation(fields: [id_user], references: [id])
  workers              Operation_Worker[]
  feeding              WorkerFeeding[]
}

model Operation_Worker {
  id           Int          @id @default(autoincrement())
  id_operation Int
  id_worker    Int
  dateEnd      DateTime?    @db.Date
  dateStart    DateTime?    @db.Date
  timeEnd      String?
  timeStart    String?
  id_group     String?
  id_task      Int?
  id_tariff    Int?
  id_subtask   Int?
  observation  String?
  billDetail   BillDetail[]
  operation    Operation    @relation(fields: [id_operation], references: [id])
  SubTask      SubTask?     @relation(fields: [id_subtask], references: [id])
  tariff       Tariff?      @relation(fields: [id_tariff], references: [id])
  task         Task?        @relation(fields: [id_task], references: [id])
  worker       Worker       @relation(fields: [id_worker], references: [id])
}

model Task {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  id_user          Int
  status           StatusActivation   @default(ACTIVE)
  id_site          Int                @default(1)
  id_subsite       Int?
  operations       Operation[]
  operation_Worker Operation_Worker[]
  SubTask          SubTask[]
  Site             Site               @relation(fields: [id_site], references: [id])
  subSite          SubSite?           @relation(fields: [id_subsite], references: [id])
  user             User               @relation(fields: [id_user], references: [id])
}

model SubTask {
  id               Int                @id @default(autoincrement())
  name             String
  code             String             @unique
  status           StatusActivation   @default(ACTIVE)
  id_task          Int
  id_subsite       Int
  id_client        Int
  operation_Worker Operation_Worker[]
  client           Client             @relation(fields: [id_client], references: [id])
  subSite          SubSite            @relation(fields: [id_subsite], references: [id])
  task             Task               @relation(fields: [id_task], references: [id])
  Tariff           Tariff[]
}

model Client {
  id         Int              @id @default(autoincrement())
  name       String
  id_user    Int
  status     StatusActivation @default(ACTIVE)
  user       User             @relation(fields: [id_user], references: [id])
  CostCenter CostCenter[]
  operations Operation[]
  SubTask    SubTask[]
}

model CalledAttention {
  id          Int       @id @default(autoincrement())
  description String?
  id_user     Int
  type        Failures?
  createAt    DateTime  @default(now())
  dni_worker  String
  worker      Worker    @relation(fields: [dni_worker], references: [dni])
  user        User      @relation(fields: [id_user], references: [id])
}

model InChargeOperation {
  id           Int       @id @default(autoincrement())
  id_user      Int
  id_operation Int
  operation    Operation @relation(fields: [id_operation], references: [id])
  user         User      @relation(fields: [id_user], references: [id])
}

model WorkerFeeding {
  id           Int           @id @default(autoincrement())
  id_worker    Int
  id_operation Int
  dateFeeding  DateTime      @db.Date
  type         FeedingStatus
  createAt     DateTime      @default(now())
  updateAt     DateTime      @updatedAt
  id_user      Int?
  operation    Operation     @relation(fields: [id_operation], references: [id])
  user         User?         @relation(fields: [id_user], references: [id])
  worker       Worker        @relation(fields: [id_worker], references: [id])
}

model Inability {
  id               Int             @id @default(autoincrement())
  dateDisableStart DateTime        @db.Date
  dateDisableEnd   DateTime        @db.Date
  type             TypeDisability
  cause            CauseDisability
  id_worker        Int
  createAt         DateTime        @default(now())
  id_user          Int
  updateAt         DateTime        @updatedAt
  user             User            @relation(fields: [id_user], references: [id])
  worker           Worker          @relation(fields: [id_worker], references: [id])
}

model Permission {
  id               Int      @id @default(autoincrement())
  dateDisableStart DateTime @db.Date
  dateDisableEnd   DateTime @db.Date
  timeStart        String
  timeEnd          String
  id_worker        Int
  id_user          Int
  observation      String?
  createAt         DateTime @default(now())
  updateAt         DateTime @updatedAt
  user             User     @relation(fields: [id_user], references: [id])
  worker           Worker   @relation(fields: [id_worker], references: [id])
}

model ClientProgramming {
  id              Int            @id @default(autoincrement())
  service_request String
  service         String
  dateStart       DateTime       @db.Date
  timeStart       String
  ubication       String
  client          String
  status          StatusComplete @default(UNASSIGNED)
  id_user         Int
  id_subsite      Int?
  id_site         Int            @default(1)
  Site            Site           @relation(fields: [id_site], references: [id])
  subSite         SubSite?       @relation(fields: [id_subsite], references: [id])
  user            User           @relation(fields: [id_user], references: [id])
  operations      Operation[]
}

model Site {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  status            StatusActivation    @default(ACTIVE)
  createAt          DateTime            @default(now())
  updateAt          DateTime            @updatedAt
  id_user           Int                 @default(36)
  ClientProgramming ClientProgramming[]
  jobAreas          JobArea[]
  operations        Operation[]
  user              User                @relation("SiteCreator", fields: [id_user], references: [id])
  SubSite           SubSite[]
  tasks             Task[]
  users             User[]
  workers           Worker[]
}

model SubSite {
  id                Int                 @id @default(autoincrement())
  name              String
  id_site           Int
  status            StatusActivation    @default(ACTIVE)
  ClientProgramming ClientProgramming[]
  CostCenter        CostCenter[]
  JobArea           JobArea[]
  Operation         Operation[]
  site              Site                @relation(fields: [id_site], references: [id])
  SubTask           SubTask[]
  Task              Task[]
  User              User[]
  Worker            Worker[]
}

model CostCenter {
  id         Int              @id @default(autoincrement())
  code       String           @unique
  name       String
  id_user    Int
  id_client  Int
  id_subsite Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  status     StatusActivation @default(ACTIVE)
  client     Client           @relation(fields: [id_client], references: [id])
  subSite    SubSite          @relation(fields: [id_subsite], references: [id])
  user       User             @relation(fields: [id_user], references: [id])
  Tariff     Tariff[]
}

model UnitOfMeasure {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  id_user      Int
  status       StatusActivation @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  Tariff       Tariff[]         @relation("FacturationUnit")
  paysheetUnit Tariff[]         @relation("PaysheetUnit")
  user         User             @relation(fields: [id_user], references: [id])
}

model Tariff {
  id                       Int                @id @default(autoincrement())
  code                     String             @unique
  id_subtask               Int
  id_costCenter            Int
  id_unidOfMeasure         Int
  id_facturation_unit      Int?
  paysheet_tariff          Decimal            @db.Decimal(15, 3)
  facturation_tariff       Decimal            @db.Decimal(15, 3)
  full_tariff              YES_NO
  compensatory             YES_NO
  isSpecial                YES_NO             @default(NO)
  alternative_paid_service YES_NO
  group_tariff             YES_NO             @default(NO)
  settle_payment           YES_NO             @default(NO)
  pay_units                Decimal?           @db.Decimal(5, 3)
  agreed_hours             Decimal?           @db.Decimal(5, 3)
  OD                       Decimal            @db.Decimal(4, 3)
  ON                       Decimal            @db.Decimal(4, 3)
  ED                       Decimal            @db.Decimal(4, 3)
  EN                       Decimal            @db.Decimal(4, 3)
  FOD                      Decimal            @db.Decimal(4, 3)
  FON                      Decimal            @db.Decimal(4, 3)
  FED                      Decimal            @db.Decimal(4, 3)
  FEN                      Decimal            @db.Decimal(4, 3)
  FAC_OD                   Decimal            @db.Decimal(4, 3)
  FAC_ON                   Decimal            @db.Decimal(4, 3)
  FAC_ED                   Decimal            @db.Decimal(4, 3)
  FAC_EN                   Decimal            @db.Decimal(4, 3)
  FAC_FOD                  Decimal            @db.Decimal(4, 3)
  FAC_FON                  Decimal            @db.Decimal(4, 3)
  FAC_FED                  Decimal            @db.Decimal(4, 3)
  FAC_FEN                  Decimal            @db.Decimal(4, 3)
  id_user                  Int
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  status                   StatusActivation   @default(ACTIVE)
  Operation_Worker         Operation_Worker[]
  costCenter               CostCenter         @relation(fields: [id_costCenter], references: [id])
  facturationUnit          UnitOfMeasure?     @relation("FacturationUnit", fields: [id_facturation_unit], references: [id])
  subTask                  SubTask            @relation(fields: [id_subtask], references: [id])
  unitOfMeasure            UnitOfMeasure      @relation("PaysheetUnit", fields: [id_unidOfMeasure], references: [id])
  user                     User               @relation(fields: [id_user], references: [id])
}

model Configuration {
  id          Int                    @id @default(autoincrement())
  name        String
  description String?
  typeValue   TypeValueConfiguration
  value       String
  status      StatusActivation       @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  id_user     Int
  user        User                   @relation(fields: [id_user], references: [id])
}

model Bill {
  id                Int          @id @default(autoincrement())
  id_operation      Int
  operation         Operation @relation(fields: [id_operation], references: [id])
  // id_tariff         Int
  // tariff            Tariff    @relation(fields: [id_tariff], references: [id])
  amount            Decimal?   @db.Decimal(15, 3)
  number_of_workers Int
  total_bill        Decimal      @db.Decimal(15, 3)
  total_paysheet    Decimal      @db.Decimal(15, 3)
  week_number       Int
  status            BillStatus   @default(ACTIVE)
  number_of_hours   Decimal?     @db.Decimal(15, 3)
  HOD               Decimal?     @db.Decimal(15, 3)
  HON               Decimal?     @db.Decimal(15, 3)
  HED               Decimal?     @db.Decimal(15, 3)
  HEN               Decimal?     @db.Decimal(15, 3)
  HFOD              Decimal?     @db.Decimal(15, 3)
  HFON              Decimal?     @db.Decimal(15, 3)
  HFED              Decimal?     @db.Decimal(15, 3)
  HFEN              Decimal?     @db.Decimal(15, 3)
  FAC_HOD           Decimal?     @db.Decimal(15, 3)
  FAC_HON           Decimal?     @db.Decimal(15, 3)
  FAC_HED           Decimal?     @db.Decimal(15, 3)
  FAC_HEN           Decimal?     @db.Decimal(15, 3)
  FAC_HFOD          Decimal?     @db.Decimal(15, 3)
  id_group          String?
  FAC_HFON          Decimal?     @db.Decimal(4, 3)
  FAC_HFED          Decimal?     @db.Decimal(4, 3)
  FAC_HFEN          Decimal?     @db.Decimal(4, 3)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  id_user           Int
  group_hours       Decimal?     @db.Decimal(15, 2)
  observation       String?
  dateStart_group   DateTime?    @db.Date
  timeStart_group   String?
  dateEnd_group     DateTime?    @db.Date
  timeEnd_group     String?
  operation         Operation    @relation(fields: [id_operation], references: [id])
  user              User         @relation(fields: [id_user], references: [id])
  billDetails       BillDetail[]
  group_hours       Decimal?  @db.Decimal(15, 3)
  observation       String?
  dateStart_group DateTime? @db.Date
  timeStart_group String?
  dateEnd_group   DateTime? @db.Date
  timeEnd_group   String?

}

model BillDetail {
  id                  Int              @id @default(autoincrement())
  id_bill             Int
  id_operation_worker Int
  pay_unit            Decimal?         @db.Decimal(15, 3)
  pay_rate            Decimal?         @db.Decimal(15, 3)
  total_bill          Decimal?         @db.Decimal(15, 3)
  total_paysheet      Decimal?         @db.Decimal(15, 3)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  bill                Bill             @relation(fields: [id_bill], references: [id])
  operationWorker     Operation_Worker @relation(fields: [id_operation_worker], references: [id])
}

model OperationConfirmation {
  id            Int       @id @default(autoincrement())
  id_operation  Int       @unique

  operation     Operation @relation(fields: [id_operation], references: [id])

  ipAddress     String?
  device        String?
  observation   String?

  confirmedAt   DateTime?

  tokens        Token[]
}

model Token {
  id               Int                     @id @default(autoincrement())
  id_confirmation  Int

  confirmation     OperationConfirmation   @relation(fields: [id_confirmation], references: [id])

  tokenHash        String                  @unique
  createdAt        DateTime                @default(now())
  status           TokenStatus             @default(ACTIVE)
  usedAt           DateTime?
}


enum TypeValueConfiguration {
  INT
  DECIMAL
  STRING
  BOOLEAN
  DATE
}

enum YES_NO {
  YES
  NO
}

enum TypeDisability {
  INITIAL
  EXTENSION
}

enum CauseDisability {
  LABOR
  TRANSIT
  DISEASE
}

enum FeedingStatus {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Role {
  ADMIN
  SUPERADMIN
  GH
  SUPERVISOR
  PROGRAMMER
}

enum Status {
  AVALIABLE
  ASSIGNED
  UNAVALIABLE
  DEACTIVATED
  DISABLE
  PERMISSION
}

enum StatusOperation {
  PENDING
  INPROGRESS
  TO_APPROVED
  APPROVED
  REJECTED
  COMPLETED
  CANCELED
  DEACTIVATED
}

enum TokenStatus {
  ACTIVE
  USED
  EXPIRED
}

enum Failures {
  INASSISTANCE
  IRRESPECTFUL
  ABANDONMENT
}

enum StatusComplete {
  COMPLETED
  INCOMPLETE
  UNASSIGNED
  ASSIGNED
}

enum StatusActivation {
  ACTIVE
  INACTIVE
}

enum BillStatus {
  TO_APPROVED
  ACTIVE
  COMPLETED
}
